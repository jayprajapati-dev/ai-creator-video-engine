# Storytelling Reel Engine - Environment Configuration Template
# Copy this file to .env if you wish to configure optional third-party integrations.
# The default engine runs locally using free procedural audio synthesis and Microsoft Edge Neural TTS without requiring any API keys.

# Optional: Port configuration for Remotion Studio (default: 3000)
# PORT=3000

# Optional: Concurrency override for Remotion rendering (default: 2)
# REMOTION_CONCURRENCY=2

# Optional: External Speech Synthesis Provider (e.g. Azure Speech / ElevenLabs)
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# ELEVENLABS_API_KEY=

